---
import { getCollection, type CollectionEntry } from "astro:content";
import PostList from "../components/PostList.astro";
import ProjectList from "../components/ProjectList.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { FEATURED_PROJECTS } from "../data/projects";
import Page from "../layouts/Page.astro";

const posts: CollectionEntry<"blog">[] = (await getCollection("blog"))
  .filter((post) => post.data.isVisible)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="mb-16">
    <h1 class="mb-4 text-display font-semibold text-balance">
      Software engineer, musician, and follower of Jesus.
    </h1>
    <p class="text-text-muted">
      I build software, play drums, and write about what I learn along the
      way. <a href="/about/" class="link" data-astro-prefetch>More about me</a>, or
      read my <a href="/blog/statement-of-faith/" class="link" data-astro-prefetch
        >statement of faith</a
      >.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="mb-5 flex items-baseline justify-between gap-4">
      <span class="font-semibold">Writing</span>
      <a href="/blog/" class="text-text-faint transition-colors hover:text-text" data-astro-prefetch
        >all posts</a
      >
    </h2>
    <PostList posts={posts} />
  </section>

  <section>
    <h2 class="mb-5 flex items-baseline justify-between gap-4">
      <span class="font-semibold">Projects</span>
      <a href="/projects/" class="text-text-faint transition-colors hover:text-text" data-astro-prefetch
        >all projects</a
      >
    </h2>
    <ProjectList projects={FEATURED_PROJECTS} />
  </section>
</Page>
