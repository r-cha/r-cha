---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Page from "../layouts/Page.astro";

const isDraft = Astro.url.pathname.startsWith("/drafts/");
---

<Page title={`Page Not Found | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <p class="mb-2 text-text-faint">404</p>
  <h1 class="mb-4 text-display font-semibold">
    {isDraft ? "Draft not found" : "Page not found"}
  </h1>
  {
    isDraft ? (
      <p class="text-text-muted">
        This draft may have been moved, deleted, or never existed. It may also
        have been promoted to a published post.{" "}
        <a href="/drafts/" class="link">View all drafts</a>, or{" "}
        <a href="/" class="link">go home</a>.
      </p>
    ) : (
      <p class="text-text-muted">
        The page you're looking for doesn't exist or has been moved.{" "}
        <a href="/" class="link">Go home</a>.
      </p>
    )
  }
</Page>
