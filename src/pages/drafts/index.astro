---
import { getCollection, type CollectionEntry } from "astro:content";
import DraftBanner from "../../components/DraftBanner.astro";
import PostList from "../../components/PostList.astro";
import Page from "../../layouts/Page.astro";

const drafts: CollectionEntry<"drafts">[] = (
  await getCollection("drafts")
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Page title="Drafts" description="Unpublished draft posts" noindex>
  <DraftBanner />
  <h1 class="mb-4 text-display font-semibold">Drafts</h1>
  <p class="mb-14 text-text-muted">
    Unpublished draft posts. They are not linked from the main site and are
    not intended for public consumption yet.
  </p>
  <PostList posts={drafts} basePath="/drafts" />
</Page>
