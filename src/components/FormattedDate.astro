---
interface Props {
  date: Date;
  withYear?: boolean;
}

const { date, withYear = true } = Astro.props;

// Dates come from frontmatter at UTC midnight; pin the zone so the build
// machine's locale cannot shift a post onto the previous day.
const label = date.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: withYear ? "numeric" : undefined,
  timeZone: "UTC",
});
---

<time datetime={date.toISOString()}>{label}</time>
