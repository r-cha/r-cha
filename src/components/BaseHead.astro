---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import legacyStyles from "../styles/legacy.css?raw";
import "@fontsource-variable/source-code-pro";
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import sourceSerif from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  image?: string;
}

// Inlined on every page, so ship it without the comments and indentation.
const legacyCss = legacyStyles
  .replace(/\/\*[\s\S]*?\*\//g, "")
  .replace(/\s*\n\s*/g, "");

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description } = Astro.props;

const pathSegments = Astro.url.pathname.split("/");
const currentPathTail = pathSegments.pop() || pathSegments.pop() || "index";
const image = "open-graph/" + currentPathTail + ".png";
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!--
  Plain-CSS baseline for engines that ignore @layer (the Kindle Experimental
  Browser and friends). Inlined ahead of the bundle on purpose - see
  src/styles/legacy.css.
-->
<style is:inline set:html={legacyCss}></style>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />

<!-- Font -->
<link
  rel="preload"
  as="font"
  href={sourceSerif}
  type="font/woff2"
  crossorigin="anonymous"
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site)} />
