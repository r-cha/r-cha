---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import legacyStyles from "../styles/legacy.css?raw";
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import sourceSerif from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url";

import { SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description: string;
  /** Key of the card generated by src/pages/open-graph/[...route].ts. */
  ogImage?: string;
  /** Set on blog posts so link previews can show them as articles. */
  article?: { published: Date; modified?: Date };
}

// Inlined on every page, so ship it without the comments and indentation.
const legacyCss = legacyStyles
  .replace(/\/\*[\s\S]*?\*\//g, "")
  .replace(/\s*\n\s*/g, "");

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, ogImage = "index", article } = Astro.props;

const imageURL = new URL(`/open-graph/${ogImage}.png`, Astro.site);
const imageAlt = `${title}, by Robert Chandler`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!--
  Plain-CSS baseline for engines that ignore @layer (the Kindle Experimental
  Browser and friends). Inlined ahead of the bundle on purpose - see
  src/styles/legacy.css.
-->
<style is:inline set:html={legacyCss}></style>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />

<!-- Font -->
<link
  rel="preload"
  as="font"
  href={sourceSerif}
  type="font/woff2"
  crossorigin="anonymous"
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />

<!-- Theme: browser chrome follows the page's light or dark palette -->
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#FFFCF0" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1C1B1A" media="(prefers-color-scheme: dark)" />

<!-- Open Graph -->
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{
  article && (
    <>
      <meta property="article:author" content="Robert Chandler" />
      <meta property="article:published_time" content={article.published.toISOString()} />
      {article.modified && (
        <meta property="article:modified_time" content={article.modified.toISOString()} />
      )}
    </>
  )
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />
