---
import type { CollectionEntry } from "astro:content";
import DraftBanner from "../components/DraftBanner.astro";
import PostHeader from "../components/PostHeader.astro";
import Page from "./Page.astro";

type Props = CollectionEntry<"drafts">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<Page title={title} description={description} noindex>
  <DraftBanner />
  <article>
    <PostHeader {...{ title, description, pubDate, updatedDate }} />
    {heroImage && <img class="mb-12 w-full rounded-md" src={heroImage} alt="" />}
    <div class="prose">
      <slot />
    </div>
  </article>
</Page>
